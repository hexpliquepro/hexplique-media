# Modèle des paramètres de hexplique-publish — SANS AUCUNE VALEUR.
# Les valeurs réelles se saisissent uniquement dans
# Settings → Secrets and variables → Actions du dépôt hexplique-publish.

# ----- Secrets (onglet « Secrets ») -----
# Token long Instagram (Instagram Login), renouvelé automatiquement chaque semaine
IG_TOKEN=
# Clé privée (.pem, contenu complet) de la GitHub App « hexplique-rotation »
APP_PRIVATE_KEY=
# Clé privée SSH de la clé de déploiement en LECTURE SEULE sur hexplique-media
MEDIA_DEPLOY_KEY=

# ----- Variables (onglet « Variables ») -----
# Identifiant numérique de la GitHub App
APP_ID=
# Dépôt des vidéos : hexpliquepro/hexplique-media
MEDIA_REPO=
# Version de l'API Graph indiquée dans le tableau de bord Meta (ex. v24.0)
META_API_VERSION=
# Garde-fou : nom du compte Instagram attendu (hexplique)
IG_EXPECTED_USERNAME=
# Hôte de l'API : vide = https://graph.instagram.com (Instagram Login) ;
# https://graph.facebook.com si l'upload direct exige Facebook Login for Business
IG_GRAPH_BASE=
# Identifiant du compte Instagram : facultatif avec Instagram Login, obligatoire sinon
IG_USER_ID=
# false uniquement avec un token d'utilisateur système (sans expiration)
ROTATION_ENABLED=
# Tenue à jour automatiquement par la rotation : ne pas remplir
IG_TOKEN_EXPIRES_AT=
